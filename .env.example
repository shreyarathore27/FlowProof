# true = in-browser mock backend (no services needed). false = call the real services.
VITE_USE_MOCK=true
# Platform service (Module B)
VITE_API_BASE=http://localhost:4000
# Lender service (Module D)
VITE_LENDER_API_BASE=http://localhost:4100
VITE_ASSISTANT_API_BASE=http://localhost:4000
# Keep this key in the backend environment only. Never prefix it with VITE_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
